{
  "openapi": "3.1.0",
  "info": {
    "title": "1Line AI API 개발 서버",
    "description": "공유 DB·실제 OpenAI 홈 분석·원본과 초안 보관. 기록 확정 저장은 백엔드에서 처리합니다.",
    "version": "0.4.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "상태"
        ],
        "summary": "Health",
        "description": "키를 노출하거나 모델을 호출하지 않고 서버와 설정 상태만 확인한다.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/context": {
      "get": {
        "tags": [
          "DB"
        ],
        "summary": "Database Context",
        "description": "공유 DB에서 실제 활동과 확정 기록을 조회한다. OpenAI는 호출하지 않는다.",
        "operationId": "database_context_api_context_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseContext"
                }
              }
            }
          },
          "503": {
            "description": "공유 DB 없음·접근 실패·문맥 오류"
          }
        }
      }
    },
    "/api/analyze/text": {
      "post": {
        "tags": [
          "분석"
        ],
        "summary": "Text Analysis",
        "description": "텍스트 분석만 수행한다. 활동 생성·기록 저장·analysisId 발급은 아직 하지 않는다.",
        "operationId": "text_analysis_api_analyze_text_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextAnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "입력 검증 실패 또는 분석 거절"
          },
          "429": {
            "description": "OpenAI 사용 한도·요청 제한"
          },
          "502": {
            "description": "OpenAI 요청·응답 검증 실패"
          },
          "503": {
            "description": "키·모델 미설정"
          },
          "504": {
            "description": "분석 시간 초과"
          }
        }
      }
    },
    "/api/chat/health": {
      "get": {
        "tags": [
          "홈 분석"
        ],
        "summary": "Chat Health",
        "operationId": "chat_health_api_chat_health_get",
        "parameters": [
          {
            "name": "checkConnection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Checkconnection"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "홈 분석"
        ],
        "summary": "Chat",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "message": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "conversationId": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "files": {
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "type": "array",
                    "maxItems": 10
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/links": {
      "post": {
        "tags": [
          "홈 분석"
        ],
        "summary": "Link",
        "operationId": "link_api_chat_links_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/jobs/{job_id}": {
      "get": {
        "tags": [
          "홈 분석"
        ],
        "summary": "Job",
        "operationId": "job_api_chat_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityContext": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Name"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ActivityContext"
      },
      "ActivityDecision": {
        "properties": {
          "match": {
            "type": "string",
            "enum": [
              "existing",
              "new",
              "unresolved"
            ],
            "title": "Match"
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Name"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match",
          "id",
          "name",
          "confidence"
        ],
        "title": "ActivityDecision"
      },
      "AnalysisContext": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/ActivityContext"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Activities"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/RecordContext"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisContext"
      },
      "Attachment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "size"
        ],
        "title": "Attachment"
      },
      "Change": {
        "properties": {
          "before": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Before"
          },
          "after": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "After"
          },
          "category": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Category"
          },
          "evidence": {
            "items": {
              "type": "string",
              "maxLength": 20000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "before",
          "after",
          "category",
          "evidence"
        ],
        "title": "Change"
      },
      "CompletedResult": {
        "properties": {
          "analysisId": {
            "type": "string",
            "title": "Analysisid"
          },
          "conversationId": {
            "type": "string",
            "title": "Conversationid"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reply": {
            "additionalProperties": true,
            "type": "object",
            "title": "Reply"
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/Attachment"
            },
            "type": "array",
            "title": "Attachments"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysisId",
          "conversationId",
          "message",
          "reply",
          "attachments",
          "createdAt"
        ],
        "title": "CompletedResult"
      },
      "ContextSelection": {
        "properties": {
          "activitiesTotal": {
            "type": "integer",
            "title": "Activitiestotal"
          },
          "activitiesIncluded": {
            "type": "integer",
            "title": "Activitiesincluded"
          },
          "recordsTotal": {
            "type": "integer",
            "title": "Recordstotal"
          },
          "recordsIncluded": {
            "type": "integer",
            "title": "Recordsincluded"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activitiesTotal",
          "activitiesIncluded",
          "recordsTotal",
          "recordsIncluded",
          "truncated"
        ],
        "title": "ContextSelection"
      },
      "DatabaseContext": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/AnalysisContext"
          },
          "selection": {
            "$ref": "#/components/schemas/ContextSelection"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "context",
          "selection"
        ],
        "title": "DatabaseContext"
      },
      "DatabaseStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "unavailable"
            ],
            "title": "Status"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DatabaseStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "ai-api-server",
            "title": "Service",
            "default": "ai-api-server"
          },
          "openai": {
            "$ref": "#/components/schemas/OpenAIConfiguration"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "type": "object",
        "required": [
          "openai",
          "database"
        ],
        "title": "HealthResponse"
      },
      "JobResponse": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "analysisProvider": {
            "type": "string",
            "const": "openai",
            "title": "Analysisprovider"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "pollAfterMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pollafterms"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompletedResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "jobId",
          "status",
          "analysisProvider"
        ],
        "title": "JobResponse"
      },
      "LinkRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url"
          },
          "conversationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversationid"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "LinkRequest"
      },
      "OpenAIConfiguration": {
        "properties": {
          "apiKeyConfigured": {
            "type": "boolean",
            "title": "Apikeyconfigured"
          },
          "modelConfigured": {
            "type": "boolean",
            "title": "Modelconfigured"
          },
          "connectionStatus": {
            "type": "string",
            "const": "not_checked",
            "title": "Connectionstatus",
            "default": "not_checked"
          }
        },
        "type": "object",
        "required": [
          "apiKeyConfigured",
          "modelConfigured"
        ],
        "title": "OpenAIConfiguration"
      },
      "Progress": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/ProgressStep"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "steps"
        ],
        "title": "Progress"
      },
      "ProgressStep": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "working"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "status"
        ],
        "title": "ProgressStep"
      },
      "RecordContext": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "activityId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Activityid"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "activityId"
        ],
        "title": "RecordContext"
      },
      "TextAnalysis": {
        "properties": {
          "activity": {
            "$ref": "#/components/schemas/ActivityDecision"
          },
          "materialType": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Materialtype"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "summary": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Summary"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Changes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activity",
          "materialType",
          "stage",
          "summary",
          "changes"
        ],
        "title": "TextAnalysis"
      },
      "TextAnalysisRequest": {
        "properties": {
          "input": {
            "$ref": "#/components/schemas/TextInput"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input"
        ],
        "title": "TextAnalysisRequest"
      },
      "TextAnalysisResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "analysisProvider": {
            "type": "string",
            "const": "openai",
            "title": "Analysisprovider",
            "default": "openai"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "activityPersisted": {
            "type": "boolean",
            "const": false,
            "title": "Activitypersisted",
            "default": false
          },
          "analysisPersisted": {
            "type": "boolean",
            "const": false,
            "title": "Analysispersisted",
            "default": false
          },
          "contextSource": {
            "type": "string",
            "enum": [
              "database",
              "request"
            ],
            "title": "Contextsource"
          },
          "contextSelection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextSelection"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis": {
            "$ref": "#/components/schemas/TextAnalysis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "model",
          "contextSource",
          "analysis"
        ],
        "title": "TextAnalysisResponse"
      },
      "TextInput": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "text",
            "title": "Kind"
          },
          "message": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "title": "TextInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "FastAPI AI 개발 서버"
    }
  ]
}
