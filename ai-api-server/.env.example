# 이 파일을 .env로 복사하고 실제 값은 로컬에서 입력한다.
# 키·모델이 없어도 상태 확인 API와 Swagger는 실행된다.
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI 요청 제한 시간(초). SDK 자동 재시도는 사용하지 않는다.
OPENAI_TIMEOUT_SECONDS=45
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 상대 경로는 ai-api-server 폴더 기준. 백엔드 DB_PATH가 다르면 같은 파일로 맞춘다.
AI_DB_PATH=../api-server/data/1line.db
AI_DB_TIMEOUT_SECONDS=5
